<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphic mid tier: white frost with a bright specular rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner" />
            <solid android:color="@color/glassmorph_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glassmorph_border" />
        </shape>
    </item>

    <item
        android:height="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glassmorph_rim" />
        </shape>
    </item>

</layer-list>
