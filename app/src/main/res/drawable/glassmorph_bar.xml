<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed glassmorphic bar: no rounded corners, bright top rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glassmorph_fill" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glassmorph_rim" />
        </shape>
    </item>

</layer-list>
