<?xml version="1.0" encoding="utf-8"?>
<!-- Mid-tier liquid glass: translucent fill, 1dp edge, top specular rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner" />
            <solid android:color="@color/glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>

    <!-- Specular rim: a single bright hairline along the top edge. -->
    <item
        android:height="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_rim" />
        </shape>
    </item>

</layer-list>
